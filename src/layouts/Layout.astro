---
import '../styles/global.css';
import LoadingOverlay from '../components/LoadingOverlay.astro';
import FloatingNav from '../components/FloatingNav.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'World of Fablea',
	description = 'An archival database of the summoned realm.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Three-tier font system per DESIGN.md §3:
		     display (serif) for grand lore titles, sans for body/UI,
		     mono for archival metadata. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<LoadingOverlay />
		<script is:raw>
			// Set data-loaded on <html> so CSS transitions can run.
			// Minimum 800ms display ensures the loading overlay is visible even
			// on local/fast loads; on deployed sites, actual resource load time
			// typically exceeds this, so it acts as a floor, not a cap.
			(function() {
				var setLoaded = function() {
					document.documentElement.setAttribute('data-loaded', 'true');
				};
				if (document.readyState === 'complete') {
					setTimeout(setLoaded, 800);
				} else {
					window.addEventListener('load', function() {
						setTimeout(setLoaded, 800);
					});
				}
			})();
		</script>
		<a href="#main" class="skip-link">Skip to content</a>
		<FloatingNav />
		<main id="main">
			<slot />
		</main>
		<!-- Faint CRT scanline texture across the whole site (DESIGN.md §6.5
		     sanctions the motif; kept static at ~3.5% opacity so it adds
		     texture without breaking AA contrast). -->
		<div class="scanlines" aria-hidden="true"></div>
	</body>
</html>
