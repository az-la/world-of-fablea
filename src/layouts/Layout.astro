---
import '../styles/global.css';
import LoadingOverlay from '../components/LoadingOverlay.astro';
import FloatingNav from '../components/FloatingNav.astro';

const {
	title = 'World of Fablea',
	description = 'An archival database of the summoned realm.'
} = Astro.props;

// DEV-only load floor (see DESIGN.md §7): the 800ms minimum keeps the
// "Decrypting Archive..." overlay visible long enough to watch the
// staggered entrance while working locally. The flag is evaluated at
// build time, so production HTML ships the no-floor variant and the
// fade cascade starts the moment window.load fires.
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
	<head>
		<base href={import.meta.env.BASE_URL} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="./favicon.svg" />
		<link rel="icon" href="./favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Three-tier font system per DESIGN.md §3:
		     display (serif) for grand lore titles, sans for body/UI,
		     mono for archival metadata. Self-hosted via @fontsource
		     (variable Inter/JetBrains Mono + static Playfair Display)
		     — see the @import block at the top of global.css. -->
	</head>
	<body>
		<LoadingOverlay />
		{
			isDev ? (
				<script is:raw>
					// DEV: hold the overlay up to 800ms after window.load so the
					// staggered entrance stays visible while working locally.
					(function() {
						var setLoaded = function() {
							setTimeout(function() {
								document.documentElement.setAttribute('data-loaded', 'true');
							}, 800);
						};
						if (document.readyState === 'complete') setLoaded();
						else window.addEventListener('load', setLoaded);
					})();
				</script>
			) : (
				<script is:raw>
					// PROD: set data-loaded on <html> the moment window.load
					// fires, so the fade cascade starts immediately.
					(function() {
						var setLoaded = function() {
							document.documentElement.setAttribute('data-loaded', 'true');
						};
						if (document.readyState === 'complete') setLoaded();
						else window.addEventListener('load', setLoaded);
					})();
				</script>
			)
		}
		<a href="#main" class="skip-link">Skip to content</a>
		<FloatingNav />
		<main id="main">
			<slot />
		</main>
		<!-- Faint CRT scanline texture across the whole site (DESIGN.md §6.5
		     sanctions the motif; kept static at ~3.5% opacity so it adds
		     texture without breaking AA contrast). -->
		<div class="scanlines" aria-hidden="true"></div>
	</body>
</html>
