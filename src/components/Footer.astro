---
// Footer: archival colophon. Only links to what exists (R-24).
const year = new Date().getFullYear();
---

<footer class="border-t border-border-subtle" style="background-color: var(--color-bg-secondary);">
	<div class="container-archival flex flex-col gap-4 py-10 md:flex-row md:items-center md:justify-between">
		<p class="font-mono text-xs tracking-[0.1em] text-text-muted uppercase">
			Fablea Prime Archive / {year}
		</p>
		<p class="text-xs text-text-secondary">
			Unofficial worldbuilding record. Not affiliated with any franchise or studio.
		</p>
	</div>
</footer>
