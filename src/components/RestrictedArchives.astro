---
import ArchiveHeader from './ArchiveHeader.astro';
import RestrictedFileBlock from './RestrictedFileBlock.astro';
import { restrictedFiles, slugify } from '../data/lore';
---

<section id="restricted" class="border-b border-border-subtle" style="background-color: var(--color-bg-primary);">
	<div class="container-archival py-14 md:py-20">
		<ArchiveHeader
			archiveId="006"
			category="Restricted"
			title="Restricted Archives"
			subtitle="There are mechanics Fablea does not broadcast."
		/>
		<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
			{
				restrictedFiles.map((file) => (
					<RestrictedFileBlock
						fileId={file.fileId}
						title={file.title}
						description={file.description}
						note={file.note}
						accessLabel={file.accessLabel}
						anchor={`restricted-${slugify(file.title)}`}
					/>
				))
			}
		</div>
	</div>
</section>
