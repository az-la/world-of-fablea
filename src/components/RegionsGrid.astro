---
import { Image } from 'astro:assets';
import ArchiveHeader from './ArchiveHeader.astro';
import LoreCard from './LoreCard.astro';
import regionsBanner from '../assets/banners/regions.jpg';
import { regions, slugify } from '../data/lore';
---

<section id="regions" class="border-b border-border-subtle">
	<div class="container-archival py-14 md:py-20">
		<ArchiveHeader
			archiveId="003"
			category="Key Regions"
			title="Explore Fablea"
			subtitle="Regions with filed dossiers"
		/>
		<Image
			src={regionsBanner}
			alt=""
			class="mb-10 h-40 w-full rounded-arch object-cover md:h-56"
			widths={[640, 960]}
			quality={65}
		/>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				regions.map((region) => (
					<LoreCard
						id={region.id}
						category="Region"
						title={region.title}
						excerpt={region.excerpt}
						status={region.status}
						statusLabel={region.statusLabel}
						href={`./regions/${slugify(region.title)}`}
						anchor={`regions-${slugify(region.title)}`}
					/>
				))
			}
		</div>
	</div>
</section>
