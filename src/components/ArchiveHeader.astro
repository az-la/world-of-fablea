---
interface Props {
	archiveId: string;
	category: string;
	title: string;
	subtitle?: string;
}

const { archiveId, category, title, subtitle } = Astro.props;
---

<header class="mb-8 md:mb-10">
	<p class="font-mono text-xs tracking-[0.15em] text-text-secondary uppercase">
		{archiveId} / {category}
	</p>
	<h1 class="mt-3 font-display text-4xl leading-tight tracking-tight text-text-primary md:text-5xl">
		{title}
	</h1>
	{subtitle && (
		<p class="mt-2 font-mono text-sm tracking-[0.05em] text-accent-gold">{subtitle}</p>
	)}
	<div class="mt-6 h-px w-full bg-border-subtle" aria-hidden="true"></div>
</header>
