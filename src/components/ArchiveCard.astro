---
interface Props {
	title: string;
	subtitle?: string;
	href?: string;
}

const { title, subtitle = '', href = '#' } = Astro.props;
---

<a href={href} class="archive-card">
	<div class="archive-card__header">
		<div class="archive-card__titles">
			<h3 class="archive-card__title">{title}</h3>
			{subtitle && <p class="archive-card__subtitle">{subtitle}</p>}
		</div>
		<div class="archive-card__badge-area">
			<slot name="badge" />
		</div>
	</div>
	<div class="archive-card__content">
		<slot />
	</div>
</a>

<style>
	.archive-card {
		display: block;
		padding: 20px;
		border-radius: var(--border-radius);
		background: var(--gradient-card);
		border: 1px solid var(--color-accent-border);
		box-shadow: var(--shadow-card);
		text-decoration: none;
		color: inherit;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}

	.archive-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-glow), var(--shadow-card);
		border-color: var(--color-accent-azure);
	}

	.archive-card__header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 16px;
		margin-bottom: 16px;
	}

	.archive-card__titles {
		flex: 1;
	}

	.archive-card__title {
		font-size: 1.1rem;
		margin: 0;
		color: var(--color-text-primary);
	}

	.archive-card__subtitle {
		font-size: 0.85rem;
		color: var(--color-text-secondary);
		margin-top: 4px;
	}

	.archive-card__badge-area {
		flex-shrink: 0;
	}

	.archive-card__content {
		font-size: 0.875rem;
		color: var(--color-text-secondary);
		line-height: 1.5;
	}

	.archive-card__content p {
		margin: 0 0 0.5rem 0;
	}

	@media (max-width: 768px) {
		.archive-card {
			padding: 16px;
		}

		.archive-card__header {
			flex-direction: column;
			align-items: flex-start;
		}

		.archive-card__badge-area {
			width: 100%;
			display: flex;
			gap: 8px;
		}
	}
</style>
