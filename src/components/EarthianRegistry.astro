---
import { Image } from 'astro:assets';
import ArchiveHeader from './ArchiveHeader.astro';
import earthiansBanner from '../assets/banners/earthians.jpg';
import { earthians, slugify } from '../data/lore';
---

<section id="earthians" class="border-b border-border-subtle" style="background-color: var(--color-bg-secondary);">
	<div class="container-archival py-14 md:py-20">
		<ArchiveHeader
			archiveId="004"
			category="The Summoned"
			title="The Earthians"
			subtitle="Pulled from nothingness. Bound to this world."
		/>
		<Image
			src={earthiansBanner}
			alt=""
			class="mb-8 h-40 w-full rounded-arch object-cover md:h-56"
			widths={[640, 960]}
			quality={65}
		/>
		<p class="mb-8 max-w-2xl text-sm leading-relaxed text-text-secondary md:text-base">
			They are non-fictional people from Earth, summoned via The Summoning. Each is created
			from nothingness, not pulled from their original universe, and bears a unique title. None
			wishes to return home.
		</p>
		<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
			{
				earthians.map((person) => (
					<article
						id={`earthians-${slugify(person.name)}`}
						class="group flex flex-col gap-2 border border-border-subtle bg-bg-primary p-4 transition-colors duration-200 hover:border-accent-gold"
					>
						<span class="font-mono text-[0.65rem] tracking-[0.1em] text-text-muted uppercase">
							Earthian / {person.no}
						</span>
						<h3 class="font-display text-base leading-snug text-text-primary transition-colors duration-200 group-hover:text-accent-gold">
							{person.name}
						</h3>
						<p class="font-mono text-[0.7rem] tracking-[0.05em] text-accent-gold uppercase">
							{person.title}
						</p>
						<p class="text-xs leading-relaxed text-text-secondary">{person.excerpt}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
