---
import ArchiveHeader from './ArchiveHeader.astro';
import DataGrid from './DataGrid.astro';

const statusItems = [
	{ key: 'World State', value: 'Harmonious', note: 'Localized conflicts monitored' },
	{ key: 'Primary Currency', value: 'AZL', note: 'Azure Land Gold, pegged 1:1 to USD' },
	{ key: 'The Summoning', value: 'Active', note: 'Min. 1 instance / month in Azure Land' },
	{ key: 'Ascension Protocol', value: 'Restricted', note: 'Azure Navy high command only' },
	{ key: 'Governance', value: 'Council', note: 'Azure Land Council / Twin Isles factions' }
];
---

<section class="border-b border-border-subtle" style="background-color: var(--color-bg-secondary);">
	<div class="container-archival py-14 md:py-20">
		<ArchiveHeader
			archiveId="002"
			category="System Monitor"
			title="World Status Dashboard"
		/>
		<DataGrid items={statusItems} />
	</div>
</section>
