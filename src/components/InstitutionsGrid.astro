---
import { Image } from 'astro:assets';
import ArchiveHeader from './ArchiveHeader.astro';
import LoreCard from './LoreCard.astro';
import institutionsBanner from '../assets/banners/institutions.jpg';
import { institutions, slugify } from '../data/lore';
---

<section id="powers" class="border-b border-border-subtle">
	<div class="container-archival py-14 md:py-20">
		<ArchiveHeader
			archiveId="005"
			category="Factions & Institutions"
			title="Powers Behind the Realm"
			subtitle="The forces that drive Fablea's economy and conflict"
		/>
		<Image
			src={institutionsBanner}
			alt=""
			class="mb-10 h-40 w-full rounded-arch object-cover md:h-56"
			widths={[640, 960]}
			quality={65}
		/>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
			{
				institutions.map((item) => (
						<LoreCard
							class:list={[item.featured ? 'sm:col-span-2' : '']}
							id={item.id}
							category="Institution"
							title={item.title}
							excerpt={item.excerpt}
							status={item.status}
							statusLabel={item.statusLabel}
							comingSoon
							anchor={`powers-${slugify(item.title)}`}
						/>
				))
			}
		</div>
	</div>
</section>
