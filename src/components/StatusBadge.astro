---
interface Props {
	label: string;
	value: string;
	variant?: 'default' | 'restricted' | 'active' | 'draft';
}

const { label, value, variant = 'default' } = Astro.props;

const variantClass = {
	default: 'badge--default',
	restricted: 'badge--restricted',
	active: 'badge--active',
	draft: 'badge--draft',
}[variant];
---

<span class={`badge ${variantClass}`}>
	<span class="badge__label">{label}</span>
	<span class="badge__value">{value}</span>
</span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		border-radius: 6px;
		font-family: var(--font-family-mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		border: 1px solid var(--color-accent-border);
		background: var(--color-bg-glass);
		backdrop-filter: blur(10px);
	}

	.badge--default {
		color: var(--color-text-secondary);
		border-color: rgba(255, 255, 255, 0.12);
	}

	.badge--restricted {
		color: var(--color-status-restricted);
		border-color: rgba(220, 38, 38, 0.3);
		background: rgba(220, 38, 38, 0.08);
	}

	.badge--active {
		color: var(--color-status-active);
		border-color: rgba(22, 163, 74, 0.3);
		background: rgba(22, 163, 74, 0.08);
	}

	.badge--draft {
		color: var(--color-status-draft);
		border-color: rgba(202, 138, 4, 0.3);
		background: rgba(202, 138, 4, 0.08);
	}

	.badge__label {
		opacity: 0.6;
	}

	.badge__value {
		font-weight: 600;
		opacity: 1;
	}
</style>
