---
interface Props {
	label: string;
	value?: string;
	variant?: 'neutral' | 'active' | 'restricted' | 'pending';
}

const { label, value, variant = 'neutral' } = Astro.props;

const variantClasses = {
	neutral: 'border-text-secondary bg-bg-tertiary text-text-primary',
	active: 'border-accent-active bg-bg-tertiary text-text-primary',
	restricted: 'border-accent-restricted bg-bg-tertiary text-text-primary',
	pending: 'border-accent-gold bg-bg-tertiary text-text-primary',
}[variant];

const leftBorder = {
	neutral: 'border-l-text-secondary',
	active: 'border-l-accent-active',
	restricted: 'border-l-accent-restricted',
	pending: 'border-l-accent-gold',
}[variant];
---

<span
	class:list={[
		'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[0.7rem] font-semibold tracking-[0.1em] uppercase',
		variantClasses,
		leftBorder
	]}
	aria-label={value ? `Status: ${label} ${value}` : `Status: ${label}`}
>
	{value && <span class="opacity-70">{label}</span>}
	<span class="font-semibold">{value ?? label}</span>
</span>
