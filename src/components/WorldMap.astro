---
import StatusBadge from './StatusBadge.astro';
---

<section class="world-map" id="key-regions">
	<div class="container">
		<div class="world-map__header">
			<h2>Key Regions</h2>
			<p class="mono">Twin Isles — Central hub of Fablea Prime</p>
		</div>
		<div class="world-map__content">
			<div class="world-map__visual">
				<div class="map">
					<div class="map__twin-isles">
						<span class="map__island-label">Twin Isles</span>
						<div class="map__marker marker--northport">Northport</div>
						<div class="map__marker marker--toyotani">Toyotani</div>
						<span class="map__distance">50km</span>
					</div>
					<div class="map__region region--azure-land">
						<span class="map__region-label">Azure Land</span>
						<span class="map__currency">Currency: AZL (1:1 USD)</span>
					</div>
					<div class="map__region region--taihei">
						<span class="map__region-label">Taihei</span>
						<span class="map__currency">Currency: TQL (= JPY)</span>
					</div>
				</div>
			</div>
			<div class="world-map__details">
				<div class="world-map__legend">
					<h3>Regional Overview</h3>
					<div class="legend-item">
						<span class="legend-dot dot--azure" />
						<span>Azure Land — Tropical maritime nation, capital Northport. Currency: AZL.</span>
					</div>
					<div class="legend-item">
						<span class="legend-dot dot--taihei" />
						<span>Taihei — Southern Twin Isles faction-state. Currency: TQL.</span>
					</div>
					<div class="legend-item">
						<span class="legend-dot dot--afrea" />
						<span>Afrea — Continental nation on Macaham. Currency: AFR.</span>
					</div>
					<div class="legend-item">
						<span class="legend-dot dot--sirmiq" />
						<span>Sirmiq — Arctic circumnavigational country. Currency: SIK.</span>
					</div>
					<div class="legend-item">
						<span class="legend-dot dot--volnyk" />
						<span>Volnyk — Southern island nation near Antarctic. Ruled by Empress Impera Loressa.</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.world-map {
		padding: 64px 0;
	}

	.world-map__header {
		margin-bottom: 32px;
	}

	.world-map__content {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 40px;
	}

	.map {
		width: 100%;
		max-width: 500px;
		height: 400px;
		position: relative;
		margin: 0 auto;
	}

	.map__twin-isles {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 80px;
		height: 80px;
		background: linear-gradient(145deg, var(--color-accent-azure), #0c7d8a);
		border-radius: 50% 50% 45% 45%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		box-shadow: 0 0 30px rgba(14, 154, 167, 0.4);
		border: 2px solid rgba(14, 154, 167, 0.6);
	}

	.map__island-label {
		font-size: 0.65rem;
		font-family: var(--font-family-mono);
		text-align: center;
		margin-bottom: 8px;
		color: var(--color-text-primary);
		font-weight: 600;
	}

	.map__marker {
		font-size: 0.6rem;
		font-family: var(--font-family-mono);
		padding: 2px 6px;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.15);
		backdrop-filter: blur(4px);
	}

	.marker--northport { margin-top: 4px; }
	.marker--toyotani { margin-top: 2px; }

	.map__distance {
		position: absolute;
		font-size: 0.6rem;
		font-family: var(--font-family-mono);
		color: var(--color-text-muted);
		top: -20px;
		right: -30px;
	}

	.map__region {
		position: absolute;
		padding: 6px 10px;
		border-radius: 8px;
		background: rgba(15, 31, 53, 0.7);
		backdrop-filter: blur(6px);
		border: 1px solid var(--color-accent-border);
		font-size: 0.7rem;
	}

	.region--azure-land {
		top: 10%;
		left: 10%;
	}

	.region--taihei {
		bottom: 10%;
		right: 10%;
	}

	.map__region-label {
		display: block;
		font-weight: 600;
		color: var(--color-text-primary);
		margin-bottom: 2px;
	}

	.map__currency {
		display: block;
		color: var(--color-accent-gold);
	}

	.legend-item {
		display: flex;
		gap: 10px;
		margin-bottom: 16px;
		align-items: flex-start;
	}

	.legend-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		margin-top: 2px;
		flex-shrink: 0;
	}

	.dot--azure {
		background: var(--color-accent-azure);
		box-shadow: 0 0 8px var(--color-accent-azure);
	}

	.dot--taihei {
		background: #ef4444;
		box-shadow: 0 0 8px #ef4444;
	}

	.dot--afrea {
		background: #8b5cf6;
		box-shadow: 0 0 8px #8b5cf6;
	}

	.dot--sirmiq {
		background: #38bdf8;
		box-shadow: 0 0 8px #38bdf8;
	}

	.dot--volnyk {
		background: #f97316;
		box-shadow: 0 0 8px #f97316;
	}

	.world-map__legend h3 {
		margin-bottom: 20px;
		font-size: 1.1rem;
	}

	@media (max-width: 768px) {
		.world-map__content {
			grid-template-columns: 1fr;
		}

		.world-map__visual {
			display: flex;
			justify-content: center;
		}
	}
</style>
