---
import StatusBadge from './StatusBadge.astro';
import ArchiveCard from './ArchiveCard.astro';

// TODO: Replace '#' hrefs with proper routes /earthians/{slug} once dynamic routes are implemented

const earthians = [
	{ title: 'Harem Maker', name: 'hmgfan', role: 'Yachting promoter for Income Makers, Northport, Azure Land' },
	{ title: 'Master of Financing', name: 'Dina Agustina', role: 'CEO of Agustina Offshore Financing, Calding Village' },
	{ title: 'Absolute Seductress', name: 'Alisha Elliott', role: 'Influencer / Venture capitalist / Lobbyist' },
	{ title: 'Great Unifier', name: 'Takechi Hironaka', role: 'Prime Minister of Taihei' },
	{ title: 'Relentless Actress', name: 'Jenny Sinclair', role: 'Elite actress and media personality' },
	{ title: 'Energetic Train Idol', name: 'Akari Hoshino', role: 'Ex-idol, master train driver for Suichi Mining' },
	{ title: 'Femme Fatale Oligarch', name: 'Mamiya Matsumoto', role: 'President of Argent Peaks' },
	{ title: 'Digital Master', name: 'Lisette Johanssen', role: 'CEO of Wraiting Inc.' },
	{ title: 'Logistics Queen', name: 'Natalie Halsey-Taylor', role: 'CEO of HT Logistics' },
	{ title: 'Thorough Fullstacker', name: 'Lee Ji-ho', role: 'Senior fullstack programmer, self-employed' },
	{ title: 'Master Influencer', name: 'Aika Yukimura', role: 'Influencer / Celebrity' },
	{ title: 'Smoke Signal', name: 'Katarina Petrenko', role: 'Soldier, mechanized infantry engineer' },
];
---

<section class="registry-preview" id="earthian-registry">
	<div class="container">
		<div class="registry-preview__header">
			<h2>Earthian Registry</h2>
			<p class="mono">12 individuals summoned from Earth — Status: Restricted</p>
		</div>
		<div class="registry-preview__grid">
			{earthians.map((e, i) => (
					<ArchiveCard
					title={e.name}
					subtitle={e.role}
					href={'#'}
				>
					<StatusBadge label="Archive" value={'00' + (i + 1)} slot="badge" />
					<StatusBadge label="Title" value={e.title} slot="badge" />
					<StatusBadge label="Designation" value="Earthian" variant="active" slot="badge" />
				</ArchiveCard>
			))}
		</div>
	</div>
</section>

<style>
	.registry-preview {
		padding: 64px 0;
	}

	.registry-preview__header {
		margin-bottom: 32px;
	}

	.registry-preview__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 20px;
	}

	@media (max-width: 768px) {
		.registry-preview {
			padding: 48px 0;
		}

		.registry-preview__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
