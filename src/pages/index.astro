---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import WorldStatusDashboard from '../components/WorldStatusDashboard.astro';
import RegionsGrid from '../components/RegionsGrid.astro';
import EarthianRegistry from '../components/EarthianRegistry.astro';
import InstitutionsGrid from '../components/InstitutionsGrid.astro';
import RestrictedArchives from '../components/RestrictedArchives.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="World of Fablea: Archival Database"
	description="An archival database of the summoned realm. Fablea Prime, where Earth's fictional characters coexist with native residents."
>
	<div class="fade-in-up fade-in-up-delay-0"><HeroSection /></div>
	<div class="fade-in-up fade-in-up-delay-1"><WorldStatusDashboard /></div>
	<div class="fade-in-up fade-in-up-delay-2"><RegionsGrid /></div>
	<div class="fade-in-up fade-in-up-delay-3"><EarthianRegistry /></div>
	<div class="fade-in-up fade-in-up-delay-4"><InstitutionsGrid /></div>
	<div class="fade-in-up fade-in-up-delay-5"><RestrictedArchives /></div>
	<div class="fade-in-up fade-in-up-delay-6"><Footer /></div>
</Layout>
